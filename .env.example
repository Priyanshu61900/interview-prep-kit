# MongoDB connection string (MongoDB Atlas free tier, or local mongod for dev).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview-prep-kit

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Groq API key (free tier). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Model id to use for generation.
GROQ_MODEL=openai/gpt-oss-120b

# Set to "production" to enable SSRF hardening (reject private/loopback company URLs).
# Leave unset locally so the batch command can target http://localhost test fixtures.
NODE_ENV=development
