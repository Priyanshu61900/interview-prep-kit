# Required. Signs session cookies. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Required. Groq free tier key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b if unset.
GROQ_MODEL=openai/gpt-oss-120b

# Optional in development: when unset, an in-memory MongoDB is started
# automatically so a clean clone runs with no database setup.
# Required in production.
MONGODB_URI=

# Optional. Defaults to development.
NODE_ENV=development
